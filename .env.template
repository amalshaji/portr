PORTR_DOMAIN=example.com

PORTR_SERVER_URL=https://example.com
PORTR_SSH_URL=example.com:2222
PORTR_SSH_PORT=2222
PORTR_PROXY_PORT=8001
PORTR_SSH_HOST_KEY=

PORTR_ADMIN_GITHUB_CLIENT_ID=
PORTR_ADMIN_GITHUB_CLIENT_SECRET=
